            font-weight: bold;
        }

        .container {
            padding: 40px 8%;
        }

        h1 {
            color: #1e293b;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 30px;
        }

        .topic {
            background: white;
            padding: 25px;
            margin: 20px 0;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .topic h2 {
            color: #4f46e5;
        }

        .topic p {
            color: #475569;
